# ============================================================
# Copy to `.env` and fill in real values.  `.env` is git-ignored.
# NEVER commit or zip real secrets.  Lines starting with `#` are comments
# (`//` is NOT a comment in .env files).
# ============================================================

NODE_ENV=production
PORT=4000

# --- Database: MongoDB Atlas (replica set, required for wallet transactions) ---
# Use a DB user with readWrite on ONE database only (not atlasAdmin). Rotate the password if it was ever shared.
MONGO_URI=mongodb+srv://DB_USER:DB_PASSWORD@cluster0.xxxxx.mongodb.net/LudoSupremeDB?retryWrites=true&w=majority
# Local single-node mongod only (NOT for production):
# MONGO_URI=mongodb://localhost:27017/ludo_supreme
# REQUIRE_REPLICA_SET=false
REQUIRE_REPLICA_SET=true
MONGO_MAX_POOL_SIZE=20
MONGO_AUTO_INDEX=true

# --- Auth ---
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 32+ chars. Changing it signs every player AND admin out.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Admin panel sessions are shorter
ADMIN_JWT_EXPIRES_IN=8h

# --- Network ---
# Browser origins allowed by CORS (comma separated). Needed ONLY if the admin panel runs as Flutter Web.
# Flutter mobile/desktop apps send no Origin header and are never blocked.
CLIENT_URL=https://ludo-admin-panel-acs.onrender.com,http://localhost:3000
# Reverse proxies in front of the app (nginx / Render / Railway = 1). Needed for correct client IPs.
TRUST_PROXY=1

# --- Admin panel ---
ADMIN_TIMEZONE=Asia/Kolkata
ADMIN_DASHBOARD_CACHE_SECONDS=30
# Hard cap for ONE manual coin credit/debit by a super admin
ADMIN_MAX_COIN_ADJUST=100000

# --- Rate limiting (per instance, in-memory) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_GAME_PER_MIN=90
RATE_LIMIT_ADMIN_AUTH_ATTEMPTS=5
RATE_LIMIT_ADMIN_IP_ATTEMPTS=30
RATE_LIMIT_ADMIN_WRITES_PER_MIN=30

# --- Game rules ---
TURN_TIMEOUT_SECONDS=15
MATCH_DURATION_SECONDS=600
ENABLE_SWEEPER=true
SWEEPER_INTERVAL_MS=5000

# --- Economy ---
SIGNUP_BONUS_COINS=1000
MAX_ENTRY_FEE=10000
# Percent of each prize pool kept by the platform (0-50). 0 = winner takes all (=> platform revenue is 0).
PLATFORM_FEE_PERCENT=0
ROOM_WAITING_TTL_MIN=30

# --- Logging ---
LOG_LEVEL=info
